{
	"schemaVersion": 1,
	"id": "easy-queue",
	"version": "${version}",
	"name": "Easy Queue",
	"description": "Makes it much easier to queue minigames on Hypixel. Run /qhelp for help.",
	"authors": [
		"downloadableduck"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/easy-play/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.jeff.easyplay.EasyPlay"
		],
		"client": [
			"com.jeff.easyplay.EasyPlayClient",
            "com.jeff.easyplay.qhelp"
		]
	},
	"mixins": [
		"easy-play.mixins.json",
		{
			"config": "easy-play.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}